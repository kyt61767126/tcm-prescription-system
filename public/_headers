# Cloudflare Pages 安全头配置
# 文档: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # 防止点击劫持（Clickjacking）
  X-Frame-Options: SAMEORIGIN
  # 防止 MIME 类型嗅探
  X-Content-Type-Options: nosniff
  # 控制 Referrer 信息泄露
  Referrer-Policy: strict-origin-when-cross-origin
  # 权限策略：允许同源使用摄像头和麦克风（APP录像拍照功能需要），禁用其他不必要的功能
  Permissions-Policy: geolocation=(), microphone=(self), camera=(self), payment=(), usb=()
  # 防止 XSS Auditor（旧版浏览器）
  X-XSS-Protection: 1; mode=block

# 页面 HTML（含内联脚本）：始终重新校验，避免浏览器/WebView 缓存旧版导致修复不生效
/index.html
  Cache-Control: no-cache, must-revalidate
/admin/index.html
  Cache-Control: no-cache, must-revalidate
/login.html
  Cache-Control: no-cache, must-revalidate
/admin/login.html
  Cache-Control: no-cache, must-revalidate

# API 接口：添加缓存控制
/api/*
  # 防止缓存敏感 API 响应
  Cache-Control: no-store, no-cache, must-revalidate
  # 防止点击劫持
  X-Frame-Options: DENY

# 静态资源：业务 JS 一律 304 校验（max-age=0 + must-revalidate）
# ★ 2026-08-20 教训：auth-core.js 曾被 max-age=86400 强缓存 24h，云端APP 两版更新不生效
#   （登录框一直显示旧"管理员激活"入口）。业务 JS 更新频繁且影响功能逻辑，必须部署后立即生效；
#   未变化时 etag 304 响应极小，性能影响可忽略。历史同类教训：video-recorder.js。
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# 第三方库（几乎不变，体积大）：保留长缓存
/qrcode.min.js
  Cache-Control: public, max-age=604800
/xlsx.full.min.js
  Cache-Control: public, max-age=604800

# 站点配置（诊所名等）：始终重新校验，部署后立即生效
/config.json
  Cache-Control: no-cache, must-revalidate

# 媒体录像/拍照脚本：禁止长缓存（历史教训，已并入上方 /*.js 规则，此处保留防回退）
/electron/video-recorder.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
