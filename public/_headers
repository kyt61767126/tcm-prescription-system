# Cloudflare Pages 安全头配置
# 文档: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # 防止点击劫持（Clickjacking）
  X-Frame-Options: SAMEORIGIN
  # 防止 MIME 类型嗅探
  X-Content-Type-Options: nosniff
  # 控制 Referrer 信息泄露
  Referrer-Policy: strict-origin-when-cross-origin
  # 权限策略：允许同源使用摄像头和麦克风（APP录像拍照功能需要），禁用其他不必要的功能
  Permissions-Policy: geolocation=(), microphone=(self), camera=(self), payment=(), usb=()
  # 防止 XSS Auditor（旧版浏览器）
  X-XSS-Protection: 1; mode=block

# 页面 HTML（含内联脚本）：始终重新校验，避免浏览器/WebView 缓存旧版导致修复不生效
# ★ 2026-08-23 补充根路径 /：云端APP(WebView)实际加载的是 /（index.html 会被 Pages 308 规范化为 /），
#   此前只配了 /index.html，根路径走 max-age=0（Android WebView 磁盘缓存不重新验证 → 线上更新不生效）。
/index.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
/admin/index.html
  Cache-Control: no-cache, must-revalidate
/login.html
  Cache-Control: no-cache, must-revalidate
/admin/login.html
  Cache-Control: no-cache, must-revalidate

# API 接口：添加缓存控制
/api/*
  # 防止缓存敏感 API 响应
  Cache-Control: no-store, no-cache, must-revalidate
  # 防止点击劫持
  X-Frame-Options: DENY

# 静态资源——根级业务 JS：内容哈希 cv + immutable 长缓存（★ 2026-09-14 云端APP打开提速）
# index.html 的 script src 一律带 ?cv=<SHA-256前8位>（tools/check-cv-hashes.cjs 自动维护，
# pre-push ⑪ 门禁强制 cv 与文件内容一致）：内容变 → cv 变 → URL 变 → 缓存键变 → 必拉新，
# 长缓存自失效；内容不变则二次打开零网络请求（云端APP WebView / 云端网页浏览器均受益）。
# ★ 2026-08-20 教训（auth-core.js 被 max-age=86400 强缓存 24h、两版更新不生效）的根因是
#   「长缓存 + 无内容哈希」——本方案内容变 URL 必变，immutable 安全；忘 bump cv 由门禁⑪拦截。
/auth-core.js
  Cache-Control: public, max-age=31536000, immutable
/permission.js
  Cache-Control: public, max-age=31536000, immutable
/normalize-config.js
  Cache-Control: public, max-age=31536000, immutable
/debug-logger.js
  Cache-Control: public, max-age=31536000, immutable
/print-utils.js
  Cache-Control: public, max-age=31536000, immutable
/medicine-dict.js
  Cache-Control: public, max-age=31536000, immutable
/symptom-dict.js
  Cache-Control: public, max-age=31536000, immutable
/cloud-api.js
  Cache-Control: public, max-age=31536000, immutable
/performance-utils.js
  Cache-Control: public, max-age=31536000, immutable
/prescription-core.js
  Cache-Control: public, max-age=31536000, immutable
/stock-core.js
  Cache-Control: public, max-age=31536000, immutable
/security-guard.js
  Cache-Control: public, max-age=31536000, immutable

# 其余 JS（/electron/ 目录副本、/hot-update/** 热包产物、admin 资源等）：304 校验兜底。
#   ★ 2026-09-14 线上实测修正：CF Pages 对未命中规则的静态资源默认即
#   Cache-Control: public, max-age=0, must-revalidate（version.json 实证），
#   显式 /*.js 兜底会与上方精确 immutable 规则【拼接成双 Cache-Control 头】
#   （max-age=0 压过 max-age=31536000 → immutable 失效），故删除该兜底行——
#   默认行为即兜底，语义不变；热包路径的 max-age=0 语义由 CF Pages 默认值保证。

# 第三方库（几乎不变，体积大）：保留长缓存
/qrcode.min.js
  Cache-Control: public, max-age=604800
/xlsx.full.min.js
  Cache-Control: public, max-age=604800

# 站点配置（诊所名等）：始终重新校验，部署后立即生效
/config.json
  Cache-Control: no-cache, must-revalidate

# 媒体录像/拍照脚本（index.html 带内容哈希 cv 引用，同根级业务 JS 机制）：immutable 长缓存
/electron/video-recorder.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
