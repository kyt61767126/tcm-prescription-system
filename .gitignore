# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist_debug
dist_new
dist-ssr
dist_old_*
dist_v*
dist_*/
*.local

# Electron 构建输出目录（避免锁定问题改用 build_output）
build_output/
build_output_old_*/
build_new/

# 构建互斥锁（tools/build-lock.ps1，运行时产物）
.build.lock

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build artifacts (kept locally under dist/releases but not tracked)
dist/releases/
dist/assets/
*.apk
*.aab
*.exe
*.dmg
*.zip
*.tar.gz
# 允许 public/downloads/ 目录下的下载文件（供 Cloudflare Pages 使用）
!public/downloads/
!public/downloads/*.apk
# 桌面版 exe>25MB 超 Cloudflare Pages 单文件上限，入库会导致部署失败，保持忽略

# 一次性修复脚本（防止误入库）
fix*.js
fix*.py
fix*.ts

# 临时校验/调试目录
_apk_check/
_apk_verify/
.interface-baseline/

# publish-release.js 临时上传目录（重命名后的 exe/apk 副本）
tools/.release-tmp/

# pack.ps1 跨版本共享缓存目录（npm/electron-builder）
tools/.npm-cache/
tools/.eb-cache/

# 敏感凭据图片
网页版密码.png
*密码*.png

# 签名密钥（绝不入库）
*.jks
*.keystore
*.p12
*.pfx
signing.properties
**/signing.properties
**/cert-password.txt

# Capacitor / Android 构建产物（覆盖根目录和子项目）
android/app/build/
android/.gradle/
android/captures/
android/local.properties
**/android/app/build/
**/android/.gradle/
**/android/captures/
**/android/local.properties

# 构建时自动生成的时间戳文件（每次打包都会更新，无需跟踪）
**/assets/public/build-time.js

# Gradle 构建产物（覆盖子项目）
.gradle/
**/.gradle/
**/build/
# 桌面版 build 目录仅保留 APP 统一图标（.gitignore 优先级最低，需先解除目录忽略再解除文件忽略）
!app_project/db-offline/desktop/build/
!app_project/db-offline/desktop/build/*
!app_project/db-yunduan/cloud_desktop/build/
!app_project/db-yunduan/cloud_desktop/build/*

# Cloudflare
.wrangler/
# Cloudflare Pages Functions 本地开发密钥文件（绝不入库）
.dev.vars
**/.dev.vars

# tcm-prescription-system 是 origin 仓库本身的 clone，避免循环引用
cloud_project/tcm-prescription-system/

# 临时验证脚本（引用了不在仓库中的目录）
_validate_*.cjs
_validate_*.js
check_syntax.cjs

# Obfuscation backup files
*.bak


# Temporary directories
tmp/


Cloudflare u{914D}u{7F6E}LICENSE_MASTER_KEY.txt
LICENSE_MASTER_KEY*
*LICENSE_MASTER_KEY*
# Cloudflare 密钥配置文件（含敏感信息，绝不入库）
Cloudflare*LICENSE_MASTER_KEY*
