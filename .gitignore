# Build artifacts (kept locally under dist/releases but not tracked)
dist/releases/
dist/assets/
*.apk
*.aab
*.exe
*.dmg
*.zip
*.tar.gz

# 一次性修复脚本（防止误入库）
fix*.js
fix*.py
fix*.ts

# 临时校验/调试目录
_apk_check/
_apk_verify/
.interface-baseline/

# 敏感凭据图片
网页版密码.png
*密码*.png

# 签名密钥（绝不入库）
*.jks
*.keystore
*.p12
*.pfx
signing.properties
**/signing.properties

# Capacitor / Android 构建产物（覆盖根目录和子项目）
android/app/build/
android/.gradle/
android/captures/
android/local.properties
**/android/app/build/
**/android/.gradle/
**/android/captures/
**/android/local.properties

# 构建时自动生成的时间戳文件（每次打包都会更新，无需跟踪）
**/assets/public/build-time.js

# Gradle 构建产物（覆盖子项目）
.gradle/
**/.gradle/
**/build/

# Cloudflare
.wrangler/

# tcm-prescription-system 是 origin 仓库本身的 clone，避免循环引用
cloud_project/tcm-prescription-system/

# 临时验证脚本（引用了不在仓库中的目录）
_validate_*.cjs
_validate_*.js
