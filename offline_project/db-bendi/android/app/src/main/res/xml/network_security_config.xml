<!--
    network_security_config.xml - 网络安全配置（离线版通用）
    P1-A5 新增：HTTPS only + 拒绝用户 CA（防 Charles/Fiddler 抓包）

    策略：
    1. 禁用所有 cleartext traffic（强制 HTTPS）
    2. 信任系统 CA，拒绝用户安装的 CA 证书（防中间人攻击）
    3. 调试模式下允许用户 CA（开发调试用，release 版不受影响）
    4. localhost 例外（用于本地 socket 连接，如安全检测中的 Frida 端口扫描）

    注意：离线 APP 仅在在线激活 license 时联网（POST /api/license/validate），
          HTTPS 仍可防止中间人攻击窃取激活码
-->
<network-security-config>
    <!-- 基础配置：拒绝明文流量（HTTPS only），拒绝用户 CA -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- 拒绝用户 CA（防 Charles/Fiddler 等抓包工具）-->
        </trust-anchors>
    </base-config>

    <!-- 本地连接例外（Frida 端口扫描、本地 socket）-->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- 调试模式覆盖：允许用户 CA 用于开发调试 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!--
        可选：云端激活 API 证书钉扎（防激活码被中间人截获）
        启用方式：取消注释并填入实际公钥哈希
        获取方式：
          echo | openssl s_client -connect tcm-prescription-system.pages.dev:443 \
            | openssl x509 -pubkey -noout \
            | openssl pkey -pubin -outform der \
            | openssl dgst -sha256 -binary | base64

    <domain-config>
        <domain includeSubdomains="true">tcm-prescription-system.pages.dev</domain>
        <pin-set expiration="2027-12-31">
            <pin digest="SHA-256">填入主公钥哈希</pin>
            <pin digest="SHA-256">填入备份公钥哈希（防止主公钥轮换导致 APP 失效）</pin>
        </pin-set>
    </domain-config>
    -->
</network-security-config>
