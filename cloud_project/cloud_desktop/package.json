{
  "name": "tcm-prescription-cloud",
  "version": "1.2.0",
  "description": "惠康中医处方系统 - 云端",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable"
  },
  "author": "惠康堂",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.huikangtang.prescription.cloud",
    "productName": "惠康中医处方系统-云端",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "electron/**/*",
      "index.html",
      "xlsx.full.min.js",
      "package.json",
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/fs-extra/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fs-extra": "^11.3.5"
  }
}
