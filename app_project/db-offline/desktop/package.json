{
  "name": "tcm-prescription-custom",
  "version": "1.0.6",
  "description": "惠康中医-定制",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "惠康中医",
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "archiver": "^7.0.1",
    "asarmor": "^3.0.2",
    "electron": "^35.0.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.benneng.prescription.clinic",
    "productName": "惠康中医-LJ",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./afterPack.js",
    "files": [
      "electron/**/*",
      "index.html",
      "config.json",
      "vendor/**/*",
      "package.json",
      "auth-core.js",
      "permission.js",
      "debug-logger.js",
      "print-utils.js",
      "medicine-dict.js",
      "db-adapter.js",
      "performance-utils.js",
      "prescription-core.js",
      "patient-archive.js",
      "security-guard.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "protocols": [
        {
          "name": "惠康中医激活协议",
          "schemes": ["bnzc"],
          "role": "Editor"
        }
      ]
    },
    "protocols": [
      {
        "name": "惠康中医激活协议",
        "schemes": ["bnzc"],
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "unicode": true,
      "include": "installer.nsh",
      "differentialPackage": false
    }
  },
  "dependencies": {
    "fs-extra": "^11.3.5"
  }
}
